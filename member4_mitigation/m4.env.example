# Member 4 settings - EXAMPLE ONLY, no secrets in this project.
#
# Every value in member4_mitigation/config.py can be overridden for one run
# without editing code, either as environment variables (prefix M4_) for a
# manually started controller:
#     set -a; source member4_mitigation/m4.env.example; set +a
# or per experiment with run_experiment.py:
#     sudo python3 member4_mitigation/run_experiment.py --scenario naive_ddos --set METER_RATE_PPS=5
#
# Values below are the defaults; uncomment to change.

# M4_MITIGATION=on                      # off = monitor only (baseline)
# M4_MITIGATE_CLASSES=naive_ddos,adaptive_ddos   # add flash_crowd to test capping crowds
# M4_KEEP_DURING_HOLD=true              # keep limits during adaptive-attack pauses
# M4_UNKNOWN_KEEPS_STATE=true           # 'unknown' decisions change nothing
# M4_RELEASE_AFTER_CLEAN_WINDOWS=1      # clean windows before limits are removed
# M4_OFFENDER_MIN_PPS=20                # a port is an offender at >= this rate ...
# M4_OFFENDER_LOOKBACK_S=10             # ... seen within the last this many seconds
# M4_MAX_LIMITED_PORTS=8                # cap on limited ports (bounds added rules)
# M4_PROTECTED_PORTS=                   # comma-separated switch ports never limited
# M4_METER_RATE_PPS=10                  # meter drop band rate (packets/s)
# M4_METER_BURST=10                     # meter burst size (packets)
# M4_RULE_PRIORITY=100                  # priority of our flow rules (Member 1 uses 1)
# M4_PORT_STATS_INTERVAL=1.0            # seconds between port-statistics polls
# M4_POLL_INTERVAL=0.2                  # seconds between decision-file checks
# M4_DECISIONS=detection/data/decisions_live.csv   # decision file to follow
# M4_RUN_DIR=member4_mitigation/logs    # where actions/events/port_stats are written
